   "source": [
    "## 10. Qualidade das respostas — RAGAS (faithfulness e answer relevancy)\n",
    "\n",
    "* **Faithfulness:** o juiz quebra a resposta em afirmações e checa quantas são sustentadas pelos contextos recuperados.\n",
    "* **Answer relevancy:** o juiz gera perguntas a partir da resposta e mede a similaridade (embeddings) com a pergunta original.\n",
    "\n",
    "O juiz é um LLM local via Ollama. Modelos pequenos às vezes devolvem JSON inválido → a métrica vira `NaN`;\n",
    "eu reporto a contagem de NaN e trato NaN como 0 na média \"pessimista\". Respostas \"Não sei\" e perguntas fora do\n",
    "escopo são avaliadas à parte (taxa de abstenção correta), porque o RAGAS não foi feito para elas."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "a422d6c4",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "application/vnd.jupyter.widget-view+json": {
       "model_id": "89411a80292641328250606c7b29f497",
       "version_major": 2,
       "version_minor": 0
      },
      "text/plain": [
       "Evaluating:   0%|          | 0/60 [00:00<?, ?it/s]"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "RAGAS concluído em 2350s\n"
     ]
    }
   ],
   "source": [
    "from ragas import evaluate, EvaluationDataset\n",
    "from ragas.metrics import Faithfulness, ResponseRelevancy\n",
    "from ragas.llms import LangchainLLMWrapper\n",
    "from ragas.embeddings import LangchainEmbeddingsWrapper\n",
    "from ragas.run_config import RunConfig\n",
    "import logging; logging.getLogger(\"ragas\").setLevel(logging.CRITICAL)   # silencia avisos de parsing do juiz\n",
    "\n",
    "juiz = LangchainLLMWrapper(ChatOllama(model=MODELO_JUIZ, temperature=0, seed=SEED, num_ctx=4096))\n",
    "emb_juiz = LangchainEmbeddingsWrapper(emb)\n",
    "\n",
    "def avaliar_ragas(df_g: pd.DataFrame) -> pd.DataFrame:\n",
    "    ds = EvaluationDataset.from_list([\n",
    "        {\"user_input\": r.pergunta, \"retrieved_contexts\": r.contextos,\n",
    "         \"response\": r.resposta or \"(vazio)\", \"reference\": r.resposta_esperada}\n",
    "        for r in df_g.itertuples()])\n",
    "    res = evaluate(ds, metrics=[Faithfulness(), ResponseRelevancy(strictness=1)],\n",
    "                   llm=juiz, embeddings=emb_juiz, raise_exceptions=False, show_progress=True,\n",
    "                   run_config=RunConfig(timeout=1800, max_workers=1, max_retries=3))   # CPU: uma chamada por vez\n",
    "    out = res.to_pandas()[[\"faithfulness\", \"answer_relevancy\"]]\n",
    "    out.index = df_g.index\n",
    "    return out\n",
    "\n",
    "mask_avaliar = (df_res[\"tipo\"] == \"factual\")\n",
    "t0 = time.perf_counter()\n",
    "df_res.loc[mask_avaliar, [\"faithfulness\", \"answer_relevancy\"]] = avaliar_ragas(df_res[mask_avaliar])\n",
    "print(f\"RAGAS concluído em {time.perf_counter()-t0:.0f}s\")\n",
    "df_res.drop(columns=\"contextos\").to_csv(PASTA_SAIDA / \"respostas_ragas.csv\", index=False)"
   ]
  },

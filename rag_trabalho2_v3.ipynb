   "source": [
    "def classificar(r):\n",
    "    if r[\"hit\"] == 0:\n",
    "        return \"falha de recuperação\" + (\" + alucinação provável\" if not r[\"nao_sei\"] else \" (absteve-se)\")\n",
    "    if r[\"nao_sei\"] or not r[\"citacao_literal\"] or (pd.notna(r[\"faithfulness\"]) and r[\"faithfulness\"] < 0.5):\n",
    "        return \"falha de geração\"\n",
    "    return \"ok\"\n",
    "\n",
    "g1 = fact[fact[\"gerador\"].str.startswith(\"ollama\")].copy()\n",
    "g1[\"diagnostico\"] = g1.apply(classificar, axis=1)\n",
    "display(g1[\"diagnostico\"].value_counts().to_frame(\"n\"))\n",
    "g1[[\"id\", \"pergunta\", \"hit\", \"nao_sei\", \"citacao_literal\", \"faithfulness\", \"diagnostico\"]]"
   ]

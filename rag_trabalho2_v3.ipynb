   "source": [
    "from langchain_core.prompts import ChatPromptTemplate\n",
    "from pydantic import BaseModel, Field\n",
    "\n",
    "# v3: em vez de pedir um formato de texto (v1/v2), o Ollama recebe um ESQUEMA JSON e a geração é\n",
    "# restringida a ele — o campo da citação passa a existir sempre. A ordem dos campos é proposital:\n",
    "# o modelo primeiro COPIA o trecho e só depois escreve a resposta a partir dele.\n",
    "class RespostaCitada(BaseModel):\n",
    "    trecho_citado: str = Field(description=\"Frase copiada palavra por palavra do CONTEXTO que sustenta a resposta. Vazio se o CONTEXTO não contém a resposta.\")\n",
    "    numero_trecho: int = Field(description=\"Número [n] do trecho de onde a frase foi copiada. 0 se o CONTEXTO não contém a resposta.\")\n",
    "    resposta: str = Field(description=\"Resposta completa em uma frase, usando só o trecho citado. Exatamente 'Não sei.' se o CONTEXTO não contém a resposta.\")\n",
    "\n",
    "SISTEMA = \"\"\"Você responde perguntas sobre um livro usando SOMENTE os trechos numerados do CONTEXTO.\n",
    "\n",
    "Regras:\n",
    "1. Use apenas o CONTEXTO. Nunca use conhecimento próprio.\n",
    "2. Primeiro copie, palavra por palavra, a frase do CONTEXTO que responde à pergunta (trecho_citado) e o número do trecho (numero_trecho).\n",
    "3. Depois escreva a resposta em uma frase completa, baseada só nessa frase.\n",
    "4. Se o CONTEXTO não contiver a resposta: trecho_citado vazio, numero_trecho 0 e resposta \"Não sei.\"\n",
    "\n",
    "Exemplo 1\n",
    "CONTEXTO:\n",
    "[1] A biblioteca central abre às 8h e fecha às 20h. Aos sábados funciona apenas pela manhã.\n",
    "[2] O empréstimo de livros é limitado a cinco títulos por aluno.\n",
    "PERGUNTA: Quantos livros um aluno pode pegar emprestado?\n",
    "{{\"trecho_citado\": \"O empréstimo de livros é limitado a cinco títulos por aluno.\", \"numero_trecho\": 2, \"resposta\": \"Cada aluno pode pegar no máximo cinco livros emprestados.\"}}\n",
    "\n",
    "Exemplo 2\n",
    "CONTEXTO:\n",
    "[1] A biblioteca central abre às 8h e fecha às 20h.\n",
    "PERGUNTA: Qual é o nome do diretor da biblioteca?\n",
    "{{\"trecho_citado\": \"\", \"numero_trecho\": 0, \"resposta\": \"Não sei.\"}}\"\"\"\n",
    "\n",
    "HUMANO = \"\"\"CONTEXTO:\n",
    "{contexto}\n",
    "\n",
    "PERGUNTA: {pergunta}\"\"\"\n",
    "\n",
    "prompt = ChatPromptTemplate.from_messages([(\"system\", SISTEMA), (\"human\", HUMANO)])\n",
    "\n",
    "def formatar_contexto(trechos: list[dict]) -> str:\n",
    "    # só o número e o texto (na v1 um cabeçalho \"(arquivo.pdf, p. X)\" era copiado no lugar da frase)\n",
    "    return \"\\n\\n\".join(f\"[{t['rank']}] {' '.join(t['texto'].split())}\" for t in trechos)\n",
    "\n",
    "def para_texto(r: RespostaCitada) -> str:\n",
    "    # converte a saída estruturada para o mesmo texto das versões anteriores (RAGAS e métricas não mudam)\n",
    "    if r.numero_trecho == 0 or not r.trecho_citado.strip() or disse_nao_sei(r.resposta):\n",
    "        return \"Não sei.\"\n",
    "    return f'Resposta: {r.resposta.strip()}\\nTrecho citado: \"{r.trecho_citado.strip()}\" [{r.numero_trecho}]'\n",
    "\n",
    "def fonte_citada(resposta: str, trechos: list[dict]) -> str:\n",
    "    m = re.findall(r\"\\[(\\d+)\\]\", resposta)\n",
    "    if not m or not (1 <= int(m[-1]) <= len(trechos)): return \"\"\n",
    "    t = trechos[int(m[-1]) - 1]\n",
    "    return f\"{t['fonte']}, p. {t['pagina']}\"\n",
    "\n",
    "def disse_nao_sei(resposta: str) -> bool:\n",
    "    return bool(re.search(r\"\\bn[aã]o sei\\b\", resposta.lower()))\n",
    "\n",
    "def citacao_literal(resposta: str, trechos: list[dict]) -> bool:\n",
    "    m = re.search(r'Trecho citado:\\s*[\"“](.+?)[\"”]', resposta, flags=re.S)\n",
    "    if not m: return False\n",
    "    citado = re.sub(r\"^\\(.*?\\)\\s*\", \"\", m.group(1).strip())\n",
    "    citado = \" \".join(normalizar(citado).split())\n",
    "    return len(citado) > 10 and any(citado in \" \".join(normalizar(t[\"texto\"]).split()) for t in trechos)\n",
    "\n",
    "print(prompt.format(contexto=formatar_contexto(recuperar(\"Quantas horas por dia um gato dorme?\", 2)),\n",
    "                    pergunta=\"Quantas horas por dia um gato dorme?\"))"
   ]

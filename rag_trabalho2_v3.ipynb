    "def demo(pergunta: str):\n",
    "    print(\"PERGUNTA:\", pergunta, \"\\n\")\n",
    "    for t in recuperar(pergunta, K_PADRAO):\n",
    "        print(f\"  [{t['rank']}] {t['fonte']} p.{t['pagina']} (cos={t['score']:.3f}) {t['texto'][:150]}...\")\n",
    "    for fn in (responder_ollama,):\n",
    "        r = fn(pergunta)\n",
    "        fonte = f\"\\n→ Fonte: {r['fonte_citada']}\" if r.get(\"fonte_citada\") else \"\"\n",
    "        print(f\"\\n=== {r['gerador']}  ({r['lat_total_s']:.2f}s) ===\\n{r['resposta']}{fonte}\")\n",
    "\n",
    "demo(perguntas[1][\"pergunta\"])"

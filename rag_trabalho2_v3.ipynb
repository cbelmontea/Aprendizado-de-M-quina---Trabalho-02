    "from langchain_text_splitters import RecursiveCharacterTextSplitter\n",
    "from langchain_huggingface import HuggingFaceEmbeddings\n",
    "from langchain_community.vectorstores import FAISS\n",
    "from langchain_community.vectorstores.utils import DistanceStrategy\n",
    "\n",
    "emb = HuggingFaceEmbeddings(model_name=MODELO_EMB, encode_kwargs={\"normalize_embeddings\": True})\n",
    "tokenizer_emb = emb._client.tokenizer          # SentenceTransformer interno\n",
    "max_tok = emb._client.max_seq_length\n",
    "\n",
    "chunks, indices, linhas = {}, {}, []\n",
    "for nome, cfg in CONFIGS_CHUNK.items():\n",
    "    splitter = RecursiveCharacterTextSplitter(**cfg, separators=[\"\\n\\n\", \"\\n\", \". \", \" \", \"\"])\n",
    "    cs = splitter.split_documents(docs)\n",
    "    for i, c in enumerate(cs):\n",
    "        c.metadata[\"chunk_id\"] = f\"{nome}-{i}\"\n",
    "    chunks[nome] = cs\n",
    "\n",
    "    n_tok = [len(tokenizer_emb.encode(c.page_content)) for c in cs]\n",
    "    t0 = time.perf_counter()\n",
    "    indices[nome] = FAISS.from_documents(cs, emb, distance_strategy=DistanceStrategy.MAX_INNER_PRODUCT)\n",
    "    t_idx = time.perf_counter() - t0\n",
    "    indices[nome].save_local(str(PASTA_SAIDA / f\"faiss_{nome}\"))\n",
    "\n",
    "    linhas.append({\"config\": nome, **cfg, \"n_chunks\": len(cs),\n",
    "                   \"chars_medio\": round(mean(len(c.page_content) for c in cs)),\n",
    "                   \"tokens_medio\": round(mean(n_tok)),\n",
    "                   f\"% truncados (> {max_tok} tok)\": round(100 * mean(t > max_tok for t in n_tok), 1),\n",
    "                   \"tempo_indexacao_s\": round(t_idx, 2)})\n",
    "\n",
    "df_chunks = pd.DataFrame(linhas); df_chunks"
   ]
  },

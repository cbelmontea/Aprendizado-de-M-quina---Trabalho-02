    "def normalizar(t: str) -> str:\n",
    "    t = unicodedata.normalize(\"NFKD\", t.lower())\n",
    "    t = \"\".join(c for c in t if not unicodedata.combining(c))\n",
    "    return re.sub(r\"[^\\w\\s]\", \" \", t)\n",
    "\n",
    "def contem_evidencia(texto: str, evidencia: str, limiar: float = 0.8) -> bool:\n",
    "    palavras_ev = normalizar(evidencia).split()\n",
    "    palavras_tx = set(normalizar(texto).split())\n",
    "    if normalizar(evidencia).strip() and \" \".join(palavras_ev) in \" \".join(normalizar(texto).split()):\n",
    "        return True\n",
    "    return mean(p in palavras_tx for p in palavras_ev) >= limiar\n",
    "\n",
    "factuais = [p for p in perguntas if p[\"tipo\"] == \"factual\"]\n",
    "linhas = []\n",
    "for nome in CONFIGS_CHUNK:\n",
    "    for p in factuais:\n",
    "        rec = recuperar(p[\"pergunta\"], k=max(KS), indice=nome)\n",
    "        pos = next((r[\"rank\"] for r in rec if contem_evidencia(r[\"texto\"], p[\"evidencia\"])), None)\n",
    "        linhas.append({\"config\": nome, \"id\": p[\"id\"], \"pos_primeiro_acerto\": pos,\n",
    "                       **{f\"hit@{k}\": int(pos is not None and pos <= k) for k in KS},\n",
    "                       \"rr\": 1 / pos if pos else 0.0})\n",
    "df_hit_det = pd.DataFrame(linhas)\n",
    "df_hit = df_hit_det.groupby(\"config\")[[f\"hit@{k}\" for k in KS] + [\"rr\"]].mean().rename(columns={\"rr\": \"MRR\"}).round(3)\n",
    "df_hit"
   ]
  },

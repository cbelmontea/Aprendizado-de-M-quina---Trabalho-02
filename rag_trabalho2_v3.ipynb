   "source": [
    "## 2. Carga e limpeza dos documentos\n",
    "Cada página vira um `Document` com metadados `fonte` e `pagina` — eles são usados na citação."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "b751f137",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "260 páginas | 1 arquivos | 510,369 caracteres\n"
     ]
    }
   ],
   "source": [
    "from langchain_community.document_loaders import PyPDFLoader, TextLoader\n",
    "\n",
    "# Páginas fora do conteúdo (capa, créditos, sumário, índice remissivo): o sumário \"casa\" com qualquer\n",
    "# pergunta e polui a recuperação. Para o Manual Completo de Gatos: conteúdo vai da p.19 à p.283.\n",
    "PAGINA_INICIAL, PAGINA_FINAL = 19, 283\n",
    "\n",
    "def limpar(texto: str) -> str:\n",
    "    texto = unicodedata.normalize(\"NFC\", texto)\n",
    "    # o PDF é um scan com OCR: descarta linhas-lixo de legendas/figuras (menos de 4 letras, ex.: \"--\", \"ti\", \".,;\")\n",
    "    texto = \"\\n\".join(l for l in texto.splitlines() if len(re.findall(r\"[^\\W\\d_]\", l)) >= 4)\n",
    "    texto = re.sub(r\"(\\w)-\\n(\\w)\", r\"\\1\\2\", texto)     # junta palavras hifenizadas na quebra de linha\n",
    "    texto = re.sub(r\"[ \\t]+\", \" \", texto)\n",
    "    texto = re.sub(r\"\\n{3,}\", \"\\n\\n\", texto)\n",
    "    return texto.strip()\n",
    "\n",
    "def carregar_documentos(pasta: Path):\n",
    "    docs = []\n",
    "    for p in sorted(pasta.glob(\"**/*\")):\n",
    "        if p.suffix.lower() == \".pdf\":\n",
    "            docs += PyPDFLoader(str(p)).load()\n",
    "        elif p.suffix.lower() in {\".txt\", \".md\"}:\n",
    "            docs += TextLoader(str(p), encoding=\"utf-8\").load()\n",
    "    for d in docs:\n",
    "        d.page_content = limpar(d.page_content)\n",
    "        d.metadata[\"fonte\"]  = Path(d.metadata[\"source\"]).name\n",
    "        d.metadata[\"pagina\"] = d.metadata.get(\"page\", 0) + 1\n",
    "    return [d for d in docs\n",
    "            if len(d.page_content) > 50 and PAGINA_INICIAL <= d.metadata[\"pagina\"] <= PAGINA_FINAL]\n",
    "\n",
    "docs = carregar_documentos(PASTA_DOCS)\n",
    "assert docs, f\"Nenhum documento encontrado em {PASTA_DOCS.resolve()}\"\n",
    "print(f\"{len(docs)} páginas | {len({d.metadata['fonte'] for d in docs})} arquivos | \"\n",
    "      f\"{sum(len(d.page_content) for d in docs):,} caracteres\")"
   ]
  },

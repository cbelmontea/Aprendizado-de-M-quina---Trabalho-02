    "from langchain_ollama import ChatOllama\n",
    "\n",
    "llm = ChatOllama(model=MODELO_OLLAMA, temperature=0, seed=SEED, num_ctx=4096)\n",
    "cadeia_rag = prompt | llm.with_structured_output(RespostaCitada, method=\"json_schema\")\n",
    "FALHAS_FORMATO = []\n",
    "\n",
    "def responder_ollama(pergunta: str, k: int = K_PADRAO) -> dict:\n",
    "    t0 = time.perf_counter()\n",
    "    trechos = recuperar(pergunta, k)\n",
    "    t1 = time.perf_counter()\n",
    "    try:\n",
    "        resposta = para_texto(cadeia_rag.invoke({\"contexto\": formatar_contexto(trechos), \"pergunta\": pergunta}))\n",
    "    except Exception as e:                       # JSON inválido (raro com esquema): registra e conta\n",
    "        FALHAS_FORMATO.append((pergunta, repr(e)[:200]))\n",
    "        resposta = \"Não sei.\"\n",
    "    t2 = time.perf_counter()\n",
    "    return {\"gerador\": f\"ollama:{MODELO_OLLAMA}\", \"resposta\": resposta, \"trechos\": trechos,\n",
    "            \"fonte_citada\": fonte_citada(resposta, trechos),\n",
    "            \"lat_recuperacao_s\": t1 - t0, \"lat_geracao_s\": t2 - t1, \"lat_total_s\": t2 - t0}\n",
    "\n",
    "_ = llm.invoke(\"Responda apenas: ok\")      # warm-up (carrega o modelo antes de medir latência)\n",
    "r = responder_ollama(perguntas[0][\"pergunta\"])\n",
    "print(r[\"resposta\"]); print(\"→ Fonte:\", r[\"fonte_citada\"]); print(f\"latência: {r['lat_total_s']:.2f}s\")"
   ]

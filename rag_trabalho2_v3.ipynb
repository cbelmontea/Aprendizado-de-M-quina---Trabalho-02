    "# Se o kernel foi reiniciado depois do RAGAS, reconstrói df_res a partir do CSV salvo pela execução da v3\n",
    "# e refaz só a busca dos trechos (determinística) — sem chamar o qwen nem o RAGAS de novo.\n",
    "if \"df_res\" not in globals():\n",
    "    df_res = pd.read_csv(PASTA_SAIDA / \"respostas_ragas.csv\")\n",
    "    perg = {p[\"id\"]: p[\"pergunta\"] for p in perguntas}\n",
    "    df_res[\"contextos\"] = [\n",
    "        [t[\"texto\"] for t in (recuperar(perg[r.id], K_PADRAO) if r.gerador.startswith(\"ollama\")\n",
    "                              else recuperar(perg[r.id], K_MINI, indice=\"pequeno\"))]\n",
    "        for r in df_res.itertuples()]\n",
    "    print(f\"df_res reconstruído do CSV: {len(df_res)} linhas\")\n",
    "FALHAS_FORMATO = globals().get(\"FALHAS_FORMATO\", [])\n",
    "\n",
    "def citacao_literal(resposta: str, trechos: list) -> bool:\n",
    "    m = re.search(r'Trecho citado:\\s*[\"“](.+?)[\"”]', resposta, flags=re.S)\n",
    "    if not m: return False\n",
    "    citado = re.sub(r\"^\\[\\d+\\]\\s*\", \"\", m.group(1).strip())        # v3.1: ignora o marcador [n] copiado\n",
    "    citado = re.sub(r\"^\\(.*?\\)\\s*\", \"\", citado)                      # e um eventual cabeçalho (arquivo, p. X)\n",
    "    citado = \" \".join(normalizar(citado).split())\n",
    "    textos = [t[\"texto\"] if isinstance(t, dict) else t for t in trechos]\n",
    "    return len(citado) > 10 and any(citado in \" \".join(normalizar(x).split()) for x in textos)\n",
    "\n",
    "antes = df_res.groupby(\"gerador\")[\"citacao_literal\"].mean() * 100\n",
    "df_res[\"citacao_literal\"] = [citacao_literal(r.resposta, r.contextos) for r in df_res.itertuples()]\n",
    "depois = df_res.groupby(\"gerador\")[\"citacao_literal\"].mean() * 100\n",
    "df_res.drop(columns=\"contextos\").to_csv(PASTA_SAIDA / \"respostas_ragas.csv\", index=False)\n",
    "pd.DataFrame({\"% citação literal (antes)\": antes, \"% citação literal (depois)\": depois}).round(1)"
   ]
  },

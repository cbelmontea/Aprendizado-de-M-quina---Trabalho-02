    "import os, re, json, time, math, random, hashlib, warnings, unicodedata\n",
    "from pathlib import Path\n",
    "from statistics import mean\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "import torch.nn.functional as F\n",
    "\n",
    "warnings.filterwarnings(\"ignore\", category=DeprecationWarning)\n",
    "pd.set_option(\"display.max_colwidth\", 120)\n",
    "\n",
    "# ---------------- parâmetros do experimento ----------------\n",
    "PASTA_DOCS   = Path(\"docs\")                  # seus PDFs / TXT aqui\n",
    "PASTA_SAIDA  = Path(\"resultados\"); PASTA_SAIDA.mkdir(exist_ok=True)\n",
    "ARQ_PERGUNTAS = Path(\"perguntas_teste.json\")\n",
    "\n",
    "MODELO_EMB    = \"sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2\"\n",
    "MODELO_OLLAMA = \"qwen2.5:3b\"\n",
    "MODELO_JUIZ   = \"qwen2.5:3b\"   # juiz do RAGAS (7b seria melhor, mas a máquina tem 8 GB de RAM e só CPU)\n",
    "\n",
    "# dois tamanhos de chunk comparados (em caracteres)\n",
    "CONFIGS_CHUNK = {\n",
    "    \"pequeno\": dict(chunk_size=400,  chunk_overlap=60),\n",
    "    \"grande\":  dict(chunk_size=1200, chunk_overlap=180),\n",
    "}\n",
    "KS        = [1, 3, 5]       # valores de k avaliados no hit@k\n",
    "K_PADRAO  = 3               # k usado pelo Gerador 1\n",
    "K_MINI    = 1               # o mini-Transformer tem janela curta: usa só o melhor trecho\n",
    "\n",
    "SEED = 42\n",
    "random.seed(SEED); np.random.seed(SEED); torch.manual_seed(SEED)\n",
    "DEVICE = \"cuda\" if torch.cuda.is_available() else (\"mps\" if torch.backends.mps.is_available() else \"cpu\")\n",
    "print(\"device:\", DEVICE)"

    "registros = []\n",
    "for p in perguntas:\n",
    "    for r in (responder_ollama(p[\"pergunta\"]), respostas_mini[p[\"id\"]]):   # qwen ao vivo + mini do Colab\n",
    "        registros.append({\n",
    "            \"id\": p[\"id\"], \"tipo\": p[\"tipo\"], \"gerador\": r[\"gerador\"], \"pergunta\": p[\"pergunta\"],\n",
    "            \"resposta_esperada\": p[\"resposta_esperada\"], \"resposta\": r[\"resposta\"],\n",
    "            \"contextos\": [t[\"texto\"] for t in r[\"trechos\"]],\n",
    "            \"hit\": int(p[\"tipo\"] == \"factual\" and any(contem_evidencia(t[\"texto\"], p[\"evidencia\"]) for t in r[\"trechos\"])),\n",
    "            \"nao_sei\": disse_nao_sei(r[\"resposta\"]),\n",
    "            \"citacao_literal\": citacao_literal(r[\"resposta\"], r[\"trechos\"]),\n",
    "            \"fonte_citada\": r.get(\"fonte_citada\", \"\"),\n",
    "            \"lat_recuperacao_s\": r[\"lat_recuperacao_s\"], \"lat_geracao_s\": r[\"lat_geracao_s\"], \"lat_total_s\": r[\"lat_total_s\"],\n",
    "        })\n",
    "    print(f\"{p['id']} ok\")\n",
    "df_res = pd.DataFrame(registros)\n",
    "df_res.drop(columns=\"contextos\").to_csv(PASTA_SAIDA / \"respostas.csv\", index=False)\n",
    "df_res[[\"id\", \"gerador\", \"resposta\", \"nao_sei\", \"citacao_literal\", \"lat_total_s\"]]"
   ]
